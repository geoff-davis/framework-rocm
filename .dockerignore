# Exclude repository and runtime-only content from the Docker build context.
# .gitignore does not affect Docker, so exclusions must be listed separately.
.git
.gitignore
.dockerignore

# Host-specific / secret-ish
.env
.env.example

# Local work mounted at runtime, never needed at build time
workspace/

# Python / notebook cruft
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Editor / OS
.vscode/
.idea/
.DS_Store
