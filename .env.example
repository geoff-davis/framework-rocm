# Copy to .env for the `docker compose` path. These are HOST-SPECIFIC, so don't
# commit the generated .env — regenerate it per machine. The run.sh wrapper
# resolves all of this automatically and does NOT need .env.
#
# Generate for this machine in one shot (also pre-creates the cache dir so
# Docker doesn't create it root-owned):
#
#   mkdir -p ~/.cache/framework-rocm && \
#   printf 'RENDER_GID=%s\nVIDEO_GID=%s\nHOST_UID=%s\nHOST_GID=%s\n' \
#     "$(getent group render | cut -d: -f3)" \
#     "$(getent group video  | cut -d: -f3)" \
#     "$(id -u)" "$(id -g)" > .env

# GIDs that own /dev/kfd and /dev/dri/render* on the host. The container's group
# file usually has no render/video entry, so the numeric GID is what works.
RENDER_GID=991
VIDEO_GID=44

# Map the container process to your host user so files written to the mounted
# ./workspace aren't root-owned. Set both to 0 to run as root (needed if you
# pip-install into system site-packages inside the container).
HOST_UID=1000
HOST_GID=1000

# Optional — host dir mounted at /workspace (default: ./workspace). Point this
# at your actual project to work on it directly.
# WORKSPACE_DIR=/home/you/projects/my-model

# Optional — host dir persisted at $HOME/.cache inside the container, keeping
# pip downloads / MIOpen kernel caches across runs
# (default: ~/.cache/framework-rocm). Create it before first use (mkdir -p).
# ROCM_CACHE_DIR=/home/you/.cache/framework-rocm

# Optional — host Hugging Face cache mounted at $HOME/.cache/huggingface so
# models download once per machine and are shared with native tools
# (default: ~/.cache/huggingface).
# ROCM_HF_CACHE=/home/you/.cache/huggingface
